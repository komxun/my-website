---
interface Props {
  label: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <p class="section-label">{label}</p>
    <h1>{title}</h1>
    {description && <p class="page-header-description">{description}</p>}
  </div>
</section>

<style>
  .page-header {
    padding-block: 90px 56px;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 15% 0%,
        rgb(37 99 235 / 12%),
        transparent 55%
      );
  }

  .page-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    margin-top: 6px;
  }

  .page-header-description {
    max-width: 640px;
    margin-top: 20px;
    font-size: 1.05rem;
  }

  @media (max-width: 600px) {
    .page-header {
      padding-block: 60px 40px;
    }
  }
</style>
