---
import Layout from "../layouts/Layout.astro";
import TagList from "./TagList.astro";
import { gradientFor, initials } from "../lib/media";

interface ExternalLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  meta?: string[];
  tags?: string[];
  backHref: string;
  backLabel: string;
  links?: ExternalLink[];
  cover?: { src?: string; alt?: string };
}

const {
  title,
  description,
  eyebrow,
  meta = [],
  tags = [],
  backHref,
  backLabel,
  links = [],
  cover,
} = Astro.props;

const coverSrc = cover?.src;
---

<Layout title={`${title} | Komsun Tamanakijprasart`} description={description}>
  <article class="entry has-banner">
    <div class="entry-banner">
      {
        coverSrc ? (
          <img class="entry-banner-img" src={coverSrc} alt={cover?.alt ?? title} />
        ) : (
          <div class="entry-banner-img entry-banner-fallback" style={`background:${gradientFor(title)}`}>
            <span class="entry-banner-mark">{initials(title)}</span>
          </div>
        )
      }
      <span class="entry-banner-fade" aria-hidden="true"></span>
    </div>

    <div class="container entry-inner">
      <a class="entry-back" href={backHref}>
        <span aria-hidden="true">←</span> {backLabel}
      </a>

      {eyebrow && <p class="section-label entry-eyebrow">{eyebrow}</p>}

      <h1 class="entry-heading">{title}</h1>

      {description && <p class="entry-lede">{description}</p>}

      {
        meta.length > 0 && (
          <div class="entry-meta">
            {meta.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        )
      }

      {tags.length > 0 && <div class="entry-tags"><TagList tags={tags} /></div>}

      {
        links.length > 0 && (
          <div class="entry-actions">
            {links.map((link) => (
              <a
                class="button button-outline"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .entry {
    padding-block: 72px 100px;
  }

  .entry.has-banner {
    padding-top: 0;
  }

  /* Faded cover banner */
  .entry-banner {
    position: relative;
    width: 100%;
    height: clamp(220px, 32vw, 380px);
    overflow: hidden;
  }

  .entry-banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .entry-banner-fallback {
    display: grid;
    place-items: center;
  }

  .entry-banner-mark {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 700;
    color: rgb(255 255 255 / 60%);
    letter-spacing: 0.05em;
  }

  .entry-banner-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(11 17 32 / 30%) 0%,
      rgb(11 17 32 / 20%) 45%,
      var(--color-bg) 100%
    );
  }

  .has-banner .entry-inner {
    position: relative;
    z-index: 1;
    margin-top: clamp(-150px, -16vw, -90px);
  }

  .entry-inner {
    max-width: 760px;
  }

  .entry-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 36px;
  }

  .entry-back:hover {
    color: var(--color-accent);
  }

  .entry-eyebrow {
    margin-bottom: 14px;
  }

  .entry-heading {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }

  .entry-lede {
    font-size: 1.15rem;
    color: var(--color-text);
    margin-top: 20px;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 24px;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .entry-meta span {
    position: relative;
  }

  .entry-meta span + span::before {
    content: "·";
    position: absolute;
    left: -12px;
  }

  .entry-tags {
    margin-top: 20px;
  }

  .entry-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .prose {
    margin-top: 32px;
    padding-top: 1px;
    border-top: 1px solid var(--color-border);
  }

  /* Don't add extra top margin to the first element in the body */
  .prose > :first-child {
    margin-top: 0;
  }
</style>
