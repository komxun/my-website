---
import Layout from "../layouts/Layout.astro";
import TagList from "./TagList.astro";
import { gradientFor, initials } from "../lib/media";

interface ExternalLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  meta?: string[];
  tags?: string[];
  backHref: string;
  backLabel: string;
  links?: ExternalLink[];
  cover?: { src?: string; alt?: string };
}

const {
  title,
  description,
  eyebrow,
  meta = [],
  tags = [],
  backHref,
  backLabel,
  links = [],
  cover,
} = Astro.props;

const coverSrc = cover?.src;
---

<Layout title={`${title} | Komsun Tamanakijprasart`} description={description}>
  <article class="entry has-banner">
    <div class="entry-banner">
      {
        coverSrc ? (
          <img class="entry-banner-img" src={coverSrc} alt={cover?.alt ?? title} />
        ) : (
          <div class="entry-banner-img entry-banner-fallback" style={`background:${gradientFor(title)}`}>
            <span class="entry-banner-mark">{initials(title)}</span>
          </div>
        )
      }
      <span class="entry-banner-fade" aria-hidden="true"></span>
    </div>

    <div class="container entry-inner">
      <a class="entry-back" href={backHref}>
        <span aria-hidden="true">←</span> {backLabel}
      </a>

      {eyebrow && <p class="section-label entry-eyebrow">{eyebrow}</p>}

      <h1 class="entry-heading">{title}</h1>

      {description && <p class="entry-lede">{description}</p>}

      {
        meta.length > 0 && (
          <div class="entry-meta">
            {meta.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        )
      }

      {tags.length > 0 && <div class="entry-tags"><TagList tags={tags} /></div>}

      {
        links.length > 0 && (
          <div class="entry-actions">
            {links.map((link) => (
              <a
                class="button button-outline"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .entry {
    padding-block: 72px 100px;
  }

  .entry.has-banner {
    padding-top: 0;
  }

  /* Faded cover banner */
  .entry-banner {
    position: relative;
    width: 100%;
    height: clamp(220px, 32vw, 380px);
    overflow: hidden;
  }

  .entry-banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .entry-banner-fallback {
    display: grid;
    place-items: center;
  }

  .entry-banner-mark {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 700;
    color: rgb(255 255 255 / 60%);
    letter-spacing: 0.05em;
  }

  .entry-banner-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(11 17 32 / 30%) 0%,
      rgb(11 17 32 / 20%) 45%,
      var(--color-bg) 100%
    );
  }

  .has-banner .entry-inner {
    position: relative;
    z-index: 1;
    margin-top: clamp(-150px, -16vw, -90px);
  }

  .entry-inner {
    max-width: 760px;
  }

  .entry-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 36px;
  }

  .entry-back:hover {
    color: var(--color-accent);
  }

  .entry-eyebrow {
    margin-bottom: 14px;
  }

  .entry-heading {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  }

  .entry-lede {
    font-size: 1.15rem;
    color: var(--color-text);
    margin-top: 20px;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 24px;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .entry-meta span {
    position: relative;
  }

  .entry-meta span + span::before {
    content: "·";
    position: absolute;
    left: -12px;
  }

  .entry-tags {
    margin-top: 20px;
  }

  .entry-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .prose {
    margin-top: 32px;
    padding-top: 1px;
    border-top: 1px solid var(--color-border);
  }

  /* Don't add extra top margin to the first element in the body */
  .prose > :first-child {
    margin-top: 0;
  }
</style>

<script>
  // Interactive pan/zoom for any <div class="zoomable"> in article content.
  function initZoomable(el: HTMLElement) {
    const img = el.querySelector<HTMLImageElement>("img");
    if (!img) return;

    const MIN = 1;
    const MAX = 6;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    const pmap = new Map<number, { x: number; y: number }>();
    let pinchDist = 0;

    const apply = () => {
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      el.classList.toggle("is-zoomed", scale > 1.001);
    };

    // Keep the image covering the frame (no empty gaps when panning).
    const clamp = () => {
      const w = el.clientWidth;
      const h = el.clientHeight;
      const minX = w - w * scale;
      const minY = h - h * scale;
      tx = Math.min(0, Math.max(minX, tx));
      ty = Math.min(0, Math.max(minY, ty));
    };

    const zoomAt = (cx: number, cy: number, factor: number) => {
      const next = Math.min(MAX, Math.max(MIN, scale * factor));
      if (next === scale) return;
      // keep the point under the cursor fixed
      tx = cx - (cx - tx) * (next / scale);
      ty = cy - (cy - ty) * (next / scale);
      scale = next;
      if (scale === 1) {
        tx = 0;
        ty = 0;
      }
      clamp();
      apply();
    };

    const rectXY = (clientX: number, clientY: number) => {
      const r = el.getBoundingClientRect();
      return { x: clientX - r.left, y: clientY - r.top };
    };

    el.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        const { x, y } = rectXY(e.clientX, e.clientY);
        zoomAt(x, y, e.deltaY < 0 ? 1.15 : 1 / 1.15);
      },
      { passive: false }
    );

    el.addEventListener("pointerdown", (e) => {
      el.setPointerCapture(e.pointerId);
      pmap.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (scale > 1) el.classList.add("is-panning");
    });

    el.addEventListener("pointermove", (e) => {
      if (!pmap.has(e.pointerId)) return;
      const prev = pmap.get(e.pointerId)!;
      const dx = e.clientX - prev.x;
      const dy = e.clientY - prev.y;
      pmap.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pmap.size === 2) {
        // pinch zoom
        const pts = [...pmap.values()];
        const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        if (pinchDist) {
          const mid = rectXY(
            (pts[0].x + pts[1].x) / 2,
            (pts[0].y + pts[1].y) / 2
          );
          zoomAt(mid.x, mid.y, dist / pinchDist);
        }
        pinchDist = dist;
      } else if (scale > 1) {
        tx += dx;
        ty += dy;
        clamp();
        apply();
      }
    });

    const endPointer = (e: PointerEvent) => {
      pmap.delete(e.pointerId);
      if (pmap.size < 2) pinchDist = 0;
      if (pmap.size === 0) el.classList.remove("is-panning");
    };
    el.addEventListener("pointerup", endPointer);
    el.addEventListener("pointercancel", endPointer);

    el.addEventListener("dblclick", (e) => {
      const { x, y } = rectXY(e.clientX, e.clientY);
      zoomAt(x, y, scale > 1 ? 1 / scale : 2.2);
    });

    el.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cx = el.clientWidth / 2;
        const cy = el.clientHeight / 2;
        const action = btn.dataset.zoom;
        if (action === "in") zoomAt(cx, cy, 1.4);
        else if (action === "out") zoomAt(cx, cy, 1 / 1.4);
        else {
          scale = 1;
          tx = 0;
          ty = 0;
          apply();
        }
      });
    });

    apply();
  }

  document
    .querySelectorAll<HTMLElement>(".prose .zoomable")
    .forEach(initZoomable);
</script>
