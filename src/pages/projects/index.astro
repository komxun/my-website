---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryCard from "../../components/EntryCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { byDateDesc, formatYear } from "../../lib/format";

const entries = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  byDateDesc
);

function externalLinks(data: (typeof entries)[number]["data"]) {
  const links = [];
  if (data.github) links.push({ label: "Code", href: data.github });
  if (data.demo) links.push({ label: "Demo", href: data.demo });
  return links;
}
---

<Layout
  title="Projects | Komsun Tamanakijprasart"
  description="Engineering projects, software implementations and experimental demonstrations in autonomous systems."
>
  <PageHeader
    label="Projects"
    title="From algorithms to autonomous systems."
    description="Selected engineering projects, implementations and experimental demonstrations."
  />

  <section class="section">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="content-grid">
            {entries.map((entry) => (
              <EntryCard
                href={`/projects/${entry.id}/`}
                eyebrow={entry.data.category}
                title={entry.data.title}
                description={entry.data.description}
                meta={`${formatYear(entry.data.date)} · ${entry.data.status}`}
                tags={entry.data.tags}
                links={externalLinks(entry.data)}
                cta="View project"
              />
            ))}
          </div>
        ) : (
          <EmptyState message="Add a Markdown file to src/content/projects/ to publish your first project." />
        )
      }
    </div>
  </section>
</Layout>
