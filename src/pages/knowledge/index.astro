---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryCard from "../../components/EntryCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { formatDate, readingTime } from "../../lib/format";

const entries = (await getCollection("knowledge", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Knowledge | Komsun Tamanakijprasart"
  description="Technical articles, mathematical formulations, algorithm explanations and implementation notes."
>
  <PageHeader
    label="Knowledge"
    title="Notes on the engineering behind autonomy."
    description="Technical articles, derivations, algorithm explanations and practical implementation notes."
  />

  <section class="section">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="content-grid">
            {entries.map((entry) => (
              <EntryCard
                href={`/knowledge/${entry.id}/`}
                eyebrow={entry.data.category}
                title={entry.data.title}
                description={entry.data.description}
                meta={`${formatDate(entry.data.date)} · ${readingTime(entry.body)}`}
                tags={entry.data.tags}
                cta="Read article"
              />
            ))}
          </div>
        ) : (
          <EmptyState message="Add a Markdown file to src/content/knowledge/ to publish your first article." />
        )
      }
    </div>
  </section>
</Layout>
