---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../components/EntryLayout.astro";
import { formatDate, readingTime } from "../../lib/format";

export async function getStaticPaths() {
  const entries = await getCollection("knowledge", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const meta = [
  entry.data.author,
  formatDate(entry.data.date),
  readingTime(entry.body),
];
if (entry.data.updated) meta.push(`Updated ${formatDate(entry.data.updated)}`);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.category}
  meta={meta}
  tags={entry.data.tags}
  backHref="/knowledge/"
  backLabel="All articles"
>
  <Content />
</EntryLayout>
