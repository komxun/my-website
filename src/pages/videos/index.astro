---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import VideoCard from "../../components/VideoCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { byDateDesc, formatDate } from "../../lib/format";

const entries = (await getCollection("videos", ({ data }) => !data.draft)).sort(
  byDateDesc
);
---

<Layout
  title="Videos | Komsun Tamanakijprasart"
  description="Video explanations of aerospace engineering, autonomy and control concepts."
>
  <PageHeader
    label="Videos"
    title="Engineering, explained on video."
    description="Walkthroughs and explainers on autonomy, control and aerospace engineering. Click any video to watch on YouTube."
  />

  <section class="section">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="content-grid videos-grid">
            {entries.map((entry) => (
              <VideoCard
                youtubeId={entry.data.youtubeId}
                title={entry.data.title}
                description={entry.data.description}
                meta={`${entry.data.category} · ${formatDate(entry.data.date)}`}
                tags={entry.data.tags}
              />
            ))}
          </div>
        ) : (
          <EmptyState message="Add a Markdown file to src/content/videos/ with a youtubeId to feature a video." />
        )
      }
    </div>
  </section>
</Layout>

<style>
  .videos-grid {
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }
</style>
