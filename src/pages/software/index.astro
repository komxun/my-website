---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryCard from "../../components/EntryCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { byDateDesc } from "../../lib/format";

const entries = (await getCollection("software", ({ data }) => !data.draft)).sort(
  byDateDesc
);

function externalLinks(data: (typeof entries)[number]["data"]) {
  const links = [{ label: "GitHub", href: data.github }];
  if (data.demo) links.push({ label: "Demo", href: data.demo });
  if (data.docs) links.push({ label: "Docs", href: data.docs });
  return links;
}
---

<Layout
  title="Software | Komsun Tamanakijprasart"
  description="Open-source software, algorithms and engineering tools — mostly backed by public GitHub repositories."
>
  <PageHeader
    label="Software"
    title="Building, testing and shipping code."
    description="Open-source implementations, algorithms and engineering tools. Each entry links straight to its GitHub repository."
  />

  <section class="section">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="content-grid">
            {entries.map((entry) => (
              <EntryCard
                href={`/software/${entry.id}/`}
                eyebrow={entry.data.language}
                title={entry.data.title}
                description={entry.data.description}
                meta={entry.data.stars != null ? `★ ${entry.data.stars}` : undefined}
                tags={entry.data.tags}
                links={externalLinks(entry.data)}
                cta="Details"
              />
            ))}
          </div>
        ) : (
          <EmptyState message="Add a Markdown file to src/content/software/ (with a github URL) to feature a repository." />
        )
      }
    </div>
  </section>
</Layout>
