---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EntryCard from "../../components/EntryCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { byDateDesc, formatYear } from "../../lib/format";

const entries = (await getCollection("research", ({ data }) => !data.draft)).sort(
  byDateDesc
);

function paperLinks(data: (typeof entries)[number]["data"]) {
  const links = [];
  if (data.paperUrl) links.push({ label: "Paper", href: data.paperUrl });
  if (data.pdf) links.push({ label: "PDF", href: data.pdf });
  return links;
}
---

<Layout
  title="Research | Komsun Tamanakijprasart"
  description="Research on autonomous navigation, swarm intelligence, multi-agent systems and intelligent decision-making."
>
  <PageHeader
    label="Research"
    title="Exploring intelligent autonomy."
    description="Research interests and ongoing work spanning autonomous navigation, multi-agent systems and learning-based control."
  />

  <section class="section">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="content-grid">
            {entries.map((entry) => (
              <EntryCard
                href={`/research/${entry.id}/`}
                eyebrow={entry.data.area}
                title={entry.data.title}
                description={entry.data.description}
                meta={entry.data.venue ?? `${formatYear(entry.data.date)} · ${entry.data.status}`}
                tags={entry.data.tags}
                links={paperLinks(entry.data)}
                cta="Explore"
                showThumb={true}
                thumbnail={entry.data.cover?.src}
                thumbAlt={entry.data.cover?.alt}
              />
            ))}
          </div>
        ) : (
          <EmptyState message="Add a Markdown file to src/content/research/ to publish your first research entry." />
        )
      }
    </div>
  </section>
</Layout>
